# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Environment / secrets ---
.env
.env.*
!.env.example
# --- TLS cert (self-signed, per-machine; key is private) ---
certs/

# --- Postgres (Docker volume data lives in-project) ---
db/data/
*.dump
*.sql.bak
# Portable data dumps: carried by Syncthing between machines, but NOT committed to git
# (may be large / contain real shop data). See scripts/db-export.sh.
db/dumps/
# Automatic backups: real shop data — Syncthing carries them for redundancy, git does not.
db/backups/

# --- Ollama / models (large; never commit) ---
models/
*.gguf
*.bin

# --- Tooling ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/
