# Copy to .env and adjust. .env is gitignored.

# --- PostgreSQL ---
POSTGRES_USER=shopkeeper
POSTGRES_PASSWORD=shopkeeper
POSTGRES_DB=shopkeeper
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Full connection string used by the app.
DATABASE_URL=postgresql://shopkeeper:shopkeeper@localhost:5434/shopkeeper

# --- Ollama (local AI) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
