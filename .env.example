# Copy to .env and adjust. .env is gitignored.

# --- PostgreSQL ---
POSTGRES_USER=shopkeeper
POSTGRES_PASSWORD=shopkeeper
POSTGRES_DB=shopkeeper
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Full connection string used by the app.
DATABASE_URL=postgresql://shopkeeper:shopkeeper@localhost:5434/shopkeeper

# --- Ollama (local AI) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Web UI ---
# 0.0.0.0 = reachable from your phone on the same Wi-Fi; 127.0.0.1 = this machine only.
WEB_HOST=0.0.0.0
WEB_PORT=8765
# Strongly recommended when WEB_HOST=0.0.0.0: a shared password the phone must enter once.
# Leave blank for no password (fine on a trusted home network).
WEB_TOKEN=
